<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ParseActivity">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/parse_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/parse_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_text_start_end_margin"
        android:layout_marginTop="@dimen/parse_label_value_top_margin"
        android:layout_marginEnd="@dimen/basic_text_start_end_margin"
        android:text="@string/parsing_text"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/basic_labels_fontsize"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_assets"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_start_end_margin"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@id/card_spent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/parse_status">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/basic_text_start_end_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/assets_value_label"
                    android:src="@drawable/ic_savings_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/progress_icon_text_margin_left"
                    android:text="@string/assets_value_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/basic_labels_fontsize" />
            </LinearLayout>

            <TextView
                android:id="@+id/assets_valueP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/progress_icon_text_margin_left"
                android:text="@string/metric_value_placeholder"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_spent"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/basic_start_end_margin"
        android:layout_marginStart="4dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/card_assets"
        app:layout_constraintTop_toTopOf="@id/card_assets">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/basic_text_start_end_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/money_spent_label"
                    android:src="@drawable/ic_spending_24"
                    app:tint="?attr/colorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/progress_icon_text_margin_left"
                    android:text="@string/money_spent_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/basic_labels_fontsize" />
            </LinearLayout>

            <TextView
                android:id="@+id/money_spent_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/progress_icon_text_margin_left"
                android:text="@string/metric_value_placeholder"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_pl"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_start_end_margin"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@id/card_rewards"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_assets">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/basic_text_start_end_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/profit_loss"
                    android:src="@drawable/ic_trending_24"
                    app:tint="?attr/colorTertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/progress_icon_text_margin_left"
                    android:text="@string/profit_loss"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/basic_labels_fontsize" />
            </LinearLayout>

            <TextView
                android:id="@+id/profit_loss_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/progress_icon_text_margin_left"
                android:text="@string/metric_value_placeholder"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_rewards"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/basic_start_end_margin"
        android:layout_marginStart="4dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/card_pl"
        app:layout_constraintTop_toTopOf="@id/card_pl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/basic_text_start_end_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/rewards_earned"
                    android:src="@drawable/ic_rewards_24"
                    app:tint="?attr/colorTertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/progress_icon_text_margin_left"
                    android:text="@string/rewards_earned"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/basic_labels_fontsize" />
            </LinearLayout>

            <TextView
                android:id="@+id/rewards_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/progress_icon_text_margin_left"
                android:text="@string/metric_value_placeholder"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_filter"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_start_end_margin"
        android:layout_marginEnd="@dimen/basic_start_end_margin"
        android:layout_marginTop="@dimen/main_big_margin_bottom"
        android:text="@string/filter_by_asset"
        android:textAllCaps="false"
        android:textSize="@dimen/basic_button_font"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_pl" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_all_tx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_start_end_margin"
        android:layout_marginEnd="@dimen/basic_start_end_margin"
        android:layout_marginTop="@dimen/main_small_margin_bottom"
        android:text="@string/all_transactions"
        android:textAllCaps="false"
        android:textSize="@dimen/basic_button_font"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_filter" />

    <TextView
        android:id="@+id/coinGeckoApiLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/basic_start_end_margin"
        android:layout_marginTop="@dimen/main_big_margin_bottom"
        android:autoLink="web"
        android:text="@string/coinGeckoAttribution"
        android:textAlignment="center"
        android:textColorLink="@color/link_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_all_tx" />

</androidx.constraintlayout.widget.ConstraintLayout>

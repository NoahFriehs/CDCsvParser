<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.WalletViewActivity">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tl_search"
        style="@style/Widget.Material3.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_start_end_margin"
        android:layout_marginTop="@dimen/basic_start_end_margin"
        android:layout_marginEnd="@dimen/basic_start_end_margin"
        android:hint="@string/filter_coin_list"
        app:startIconDrawable="@drawable/ic_search_24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            tools:ignore="LabelFor" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/sorting_string"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_text_start_end_margin"
        android:layout_marginTop="2dp"
        android:text="@string/sort_by"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/basic_labels_fontsize"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tl_search" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tl_sort_value"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_start_end_margin"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/basic_start_end_margin"
        app:layout_constraintRight_toLeftOf="@id/tl_sort_type"
        app:layout_constraintTop_toBottomOf="@id/sorting_string">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/sorting_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:minWidth="220dp"
            tools:ignore="LabelFor" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tl_sort_type"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/progress_icon_text_margin_left"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/basic_start_end_margin"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sorting_string">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/sorting_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:minWidth="120dp"
            tools:ignore="LabelFor" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/chart_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_text_start_end_margin"
        android:layout_marginTop="@dimen/wallet_sortBy_margin_top"
        android:text="@string/allocation_title"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/main_small_font"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tl_sort_value" />

    <FrameLayout
        android:id="@+id/chart_container"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:layout_marginStart="@dimen/basic_start_end_margin"
        android:layout_marginTop="@dimen/progress_icon_text_margin_left"
        android:layout_marginEnd="@dimen/basic_start_end_margin"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chart_header">

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/allocation_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/allocation_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_allocation_data"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/wallet_frame_margin_top"
        android:padding="@dimen/basic_start_end_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chart_container" />

</androidx.constraintlayout.widget.ConstraintLayout>

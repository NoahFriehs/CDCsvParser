<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (Android 12+).
   Financial data (the local Room database) and the log files (which can
   contain import metadata) are deliberately excluded from cloud backup
   and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="my-database-name" />
        <exclude domain="file" path="CDCsvParser.log" />
        <exclude domain="file" path="log/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="my-database-name" />
        <exclude domain="file" path="CDCsvParser.log" />
        <exclude domain="file" path="log/" />
    </device-transfer>
</data-extraction-rules>

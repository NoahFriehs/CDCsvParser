<?xml version="1.0" encoding="utf-8"?>
<!--
   Full backup rules (Android 11 and lower), ignored on API 31+.
   Financial data and logs are kept local-only (see data_extraction_rules.xml).
-->
<full-backup-content>
    <exclude domain="database" path="my-database-name" />
    <exclude domain="file" path="CDCsvParser.log" />
    <exclude domain="file" path="log/" />
</full-backup-content>
